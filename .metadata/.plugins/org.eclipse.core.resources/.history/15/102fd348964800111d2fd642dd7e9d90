package arrays;

public class twoD_Array_min_max_Elements {

	public static void main(String[] args) {
		int max = arr[0][0];

		for (int i = 0; i < arr.length; i++) {
		    for (int j = 0; j < arr[i].length; j++) {
		        if (arr[i][j] > max) {
		            max = arr[i][j];
		        }
		    }
		}

		System.out.println(max);
	}

}
