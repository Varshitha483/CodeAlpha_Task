package arrays;

public class Array_Introduction {
	public static void main (String[] args) {
		
		/*int array[] = new int[5];
		array[0] = 5;
		array[1] = 2;
		array[2] = 6;                   // It includes Declaration and Creation of array
		array[3] = 9;
		array[4] = 1;*/
		
		int array[] = { 5, 2, 6, 9, 1};                // It includes Declaration, Creation and Initialization of array
		
		
		System.out.println(array[4]);        // accessing elements by index
		
		array[2] = 10;        // modifying the element
		
		for( int i=0; i<array.length;i++)           // for displaying the whole array
			System.out.print(array[i] + " ");
		System.out.println();                 // just to print next statements in another line not in same line
		
		
		// Another program for odd and even numbers
		for(int i=0; i<array.length;i++)
			if(array[i] % 2 == 0)
				System.out.println("Even numbers in array: " + array[i]);
		
		for(int i=0; i<array.length;i++)
			if(array[i] % 2 != 0)
				System.out.println("Odd numbers in array: " + array[i]);
		
		
		// Inserting elements in an array
		 
		int newArray[] = new int[6];
		
		for( int i=0; i<array.length;i++)
			newArray[i] = array[i];
		newArray[5] = 40;
		for( int i=0; i<newArray.length;i++)
			System.out.print(newArray[i] + " ");
		System.out.println();
		
		// Delete elements in an array
		
		int deleteIndex = 2;
		int Deleted_array[] = new int[array.length-1];

		for (int i = 0; i < deleteIndex ; i++) 
			Deleted_array[i] = array[i];

		for (int i = deleteIndex + 1; i < array.length; i++)
			Deleted_array[i-1] = array[i];
		
		for (int i = 0; i < Deleted_array.length; i++)
			System.out.print(Deleted_array[i] + " ");      // output: 5 2 9 1 removed 10 from (array)
		
		System.out.println();
		
		// Merging two arrays
		
		int array1[] = {1,2,3,4,5};
		int array2[] = {6,7,8,9,10};
		int Merged_array[] = new int[array1.length + array2.length];
		
		for(int i=0; i< array1.length;i++)
			Merged_array[ i ] = array1[i];
		
		for(int i=0; i< array2.length;i++)
			Merged_array[array1.length+i] = array2[i];
		
		for(int i =0; i < Merged_array.length;i++)
			System.out.print(Merged_array[i] + " ");
		
		
		for(int i=0; i< array1.length;i++)
			System.out.print(array1[i]);
		
		for(int i=0; i< array2.length;i++)
			System.out.print(array2[i]);
		
		System.out.println(array1[i] + array2[i]);
		    
		
	}
}
