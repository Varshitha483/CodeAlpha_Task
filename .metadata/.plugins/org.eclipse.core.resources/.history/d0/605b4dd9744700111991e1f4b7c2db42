package minmax;

public class MimMax {

	public static void main(String[] args) {
		int arr[] = {16,20,13,12,30};
		int min = arr[0];          // Let us assume min as 0 index element
		int max = arr[0];
		
		for(int i=0;i<arr.length;i++) {
			
			if(arr[i]<min) {
				min = arr[i];
			}
			if(arr[i]>max) {
				max = arr[i];
			}
		}
		
		System.out.println(min);
		
	}

}
