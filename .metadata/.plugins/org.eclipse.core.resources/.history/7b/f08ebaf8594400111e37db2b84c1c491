package array_duplicates;

public class Array_Duplicates {

	public static void main(String[] args) {
		int arr[] = {5,8,9,6,5,6,6,9};
		int index = 1;
		
		for(int i=1; i<arr.length;i++) {
			if(arr[i] != arr[i-1]) {
				arr[index] = arr[i];
				index++;
			}
		}
		for(int i=0; i<index; i++) {
			System.out.print(arr[i] + " ");
		}
	}

}
