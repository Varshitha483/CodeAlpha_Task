package arrays;

public class twoD_Array_Introduction {

	public static void main(String[] args) {

		// Dynamic Initilization:   Values are given at runtime (user input)
		// int array[][] = new int[3][2];      // Creating and Declaring an Array 


		// Static Initilization: Values are given directly
		int array[][] = {
				{1,2,3},
				{4,5,6}
		};

		System.out.print(array[0][2]);         // Accessing the elements
		System.out.println();

		// Modifying Arrays
		array[1][1] = 10;

		for(int i=0;i<array.length;i++)
			for(int j=0;j<array[i].length;j++)
				System.out.print(array[i][j] + " ");
		System.out.println();

	}

}
