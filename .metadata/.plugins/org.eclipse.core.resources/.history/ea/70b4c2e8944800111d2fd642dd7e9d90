package arrays;

public class twoD_Array_Introduction {

	public static void main(String[] args) {

		// Dynamic Initilization:   Values are given at runtime (user input)
		// int array[][] = new int[3][2];      // Creating and Declaring an Array 


		// Static Initilization: Values are given directly
		int array[][] = {
				{1,2,3},
				{4,5,6}
		};

		System.out.print(array[0][2]);         // Accessing the elements
		System.out.println();

		// Modifying Arrays
		
		array[1][1] = 10;

		for(int i=0;i<array.length;i++) {                   // Because you did not use { }, the loops only include the print statement and println() runs once outside, so everything prints in one line.
			for(int j=0;j<array[i].length;j++) {            // Use {}
				System.out.print(+ array[i][j] + " ");
			}
		    System.out.println();
		    System.out.println();
		}
		
		// Traversing a 2D array :: Traversing a 2D array means going through all elements OR only the elements you need.

		for (int j = 0; j < array[0].length; j++)        // only first row
		    System.out.print(array[0][j] + " ");
		System.out.println();
		

		for (int i = 0; i < array.length; i++)           // only one column
		    System.out.print(array[i][1] + " ");
		System.out.println();


		for (int i = 0; i < array.length; i++)           // only Diagonals
		    System.out.print(array[i][i] + " ");
		System.out.println();
		
	}

}