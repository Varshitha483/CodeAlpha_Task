package arrays;

public class Array_Rotation {

	public static void main(String[] args) {
		int[] arr = {1, 2, 3, 4, 5};
        int k = 2;

        for (int i = 0, j = arr.length - 1; i < j; i++, j--) {
            int temp = arr[i];
            arr[i] = arr[j];
            arr[j] = temp;
        }

        for (int i = 0, j = k - 1; i < j; i++, j--) {
            int temp = arr[i];
            arr[i] = arr[j];
            arr[j] = temp;
            System.out.println(arr[i]);
        }

	}

}
