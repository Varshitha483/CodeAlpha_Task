package arrays;


public class Array_Rotation {

	public static void arrayRotation(int[] arr, int start, int end) {

		while ( start < end ) {
			int temp = arr[start];
			arr[start] = arr[end];
			arr[end] = temp;

			start++;
			end--;
		}
	}
	
	public static void main(String[] args) {
		int arr[] = {1,2,3,4,5};
		int k=2;
		int n = arr.length;
		
		arrayRotation(arr,0,n-1);    // whole array reverse
		
		arrayRotation(arr,0,arr.length-3);
		
		
		for(int i=0; i<arr.length;i++)
		System.out.print(arr[i] + " ");
	}

}
