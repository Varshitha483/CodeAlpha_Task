package arrays;

import java.lang.reflect.Array;

public class Array_Rotation {

	public static void arrayRotation(int[] arr, int start, int end) {

		while ( start < end ) {
			int temp = arr[start];
			arr[start] = arr[end];
			arr[end] = temp;

			start++;
			end--;
		}
	}
	
	public static void main(String[] args) {
		int arr[] = {1,2,3,4,5};
