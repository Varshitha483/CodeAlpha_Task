package arrays;

public class Array_Introduction {
	public static void main (String[] args) {
		int array[] = new int[5];
		array[0] = 5;
		array[1] = 2;
		array[2] = 6;                   // It includes Declaration and Creation of array
		array[3] = 9;
		array[4] = 1;
		
		// int array[] = { 5, 2, 6, 9, 1};                It includes Declaration, Creation and Initialization of array
		
		
		System.out.println(array[4]);
		
		array[2] = 10;        // modifying the element
		
		for( int i=0; i<array.length;i++) {         // for displaying the whole array
			System.out.print(array[i] + " ");
		}
		
	}
}
