package diamond;
public class DiamondPattern {
	public static void main(String[] args) {

		int n = 4;

		//  Top part
		for (int i = 1; i <= n; i++) {

			// spaces
			for (int j = 1; j <= n - i; j++) {
				System.out.print("  ");
			}

			// stars
			for (int j = 1; j <= i; j++) {
				System.out.print("*");
			}

			System.out.println();
		}

		//  Bottom part
		for (int i = n - 1; i >= 1; i--) {

			// spaces
			for (int j = 1; j <= n - i; j++) {
				System.out.print("  ");
			}

			// stars
			for (int j = 1; j <= i; j++) {
				System.out.print("*   ");
			}

			System.out.println();
		}
	}
}